{
  "name": "@paxiom/receipts",
  "version": "0.1.3",
  "mcpName": "io.github.k-luecke/paxiom-receipts",
  "description": "Zero-dependency issuer, verifier, buyer preflight/live client, HTTP middleware, and MCP server for paxiom.receipt.v0 \u2014 proof-bound cryptographic receipts for x402 and agentic APIs.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://paxiom.org/receipts.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-luecke/paxiom-static.git",
    "directory": "standards/receipts/v0"
  },
  "bugs": {
    "url": "https://github.com/k-luecke/paxiom-static/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./client": {
      "types": "./src/index.d.ts",
      "default": "./src/client.mjs"
    },
    "./verify": {
      "types": "./src/index.d.ts",
      "default": "./src/verify.mjs"
    },
    "./issue": {
      "types": "./src/index.d.ts",
      "default": "./src/issue.mjs"
    },
    "./middleware": {
      "types": "./src/index.d.ts",
      "default": "./src/middleware.mjs"
    },
    "./canonicalize": {
      "types": "./src/index.d.ts",
      "default": "./src/canonicalize.mjs"
    },
    "./explain": {
      "types": "./src/index.d.ts",
      "default": "./src/explain.mjs"
    },
    "./mcp": "./mcp/server.mjs",
    "./schema.json": "./paxiom.receipt.v0.schema.json"
  },
  "bin": {
    "paxiom-receipt": "./bin/paxiom-receipt.mjs",
    "paxiom-receipt-mcp": "./mcp/server.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "canonicalization.md",
    "trust-states.md",
    "paxiom.receipt.v0.schema.json",
    "openapi.json",
    "server.json",
    "src/",
    "bin/",
    "mcp/server.mjs",
    "server/server.mjs",
    "examples/"
  ],
  "scripts": {
    "validate": "node ./scripts/validate.mjs",
    "test": "node --test ./test/ ./server/ ./mcp/"
  },
  "keywords": [
    "x402",
    "receipts",
    "ed25519",
    "agent-payments",
    "mcp",
    "proof-of-delivery",
    "verification",
    "paxiom"
  ]
}
