{
  "name": "@paxiom/receipts",
  "version": "0.3.0",
  "mcpName": "io.github.k-luecke/paxiom-receipts",
  "description": "Zero-dependency open-standard issuer, verifier, pure WebCrypto/Workers runtime (@paxiom/receipts/web), buyer policy firewall & AuthCaptureEscrow arbiter (@paxiom/receipts/guard), x402 v2 middleware, and MCP server for proof-bound delivery receipts (paxiom.receipt.v0).",
  "type": "module",
  "license": "MIT",
  "homepage": "https://paxiom.org/receipts.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-luecke/paxiom-static.git",
    "directory": "standards/receipts/v0"
  },
  "bugs": {
    "url": "https://github.com/k-luecke/paxiom-static/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./web": {
      "types": "./src/web.d.ts",
      "default": "./src/web.mjs"
    },
    "./guard": {
      "types": "./src/guard.d.ts",
      "default": "./src/guard.mjs"
    },
    "./bytes": {
      "types": "./src/web.d.ts",
      "default": "./src/bytes.mjs"
    },
    "./schema": {
      "types": "./src/web.d.ts",
      "default": "./src/schema.mjs"
    },
    "./client": {
      "types": "./src/index.d.ts",
      "default": "./src/client.mjs"
    },
    "./verify": {
      "types": "./src/index.d.ts",
      "default": "./src/verify.mjs"
    },
    "./issue": {
      "types": "./src/index.d.ts",
      "default": "./src/issue.mjs"
    },
    "./middleware": {
      "types": "./src/index.d.ts",
      "default": "./src/middleware.mjs"
    },
    "./canonicalize": {
      "types": "./src/web.d.ts",
      "default": "./src/canonicalize.mjs"
    },
    "./explain": {
      "types": "./src/web.d.ts",
      "default": "./src/explain.mjs"
    },
    "./mcp": "./mcp/server.mjs",
    "./schema.json": "./paxiom.receipt.v0.schema.json"
  },
  "bin": {
    "paxiom-receipt": "./bin/paxiom-receipt.mjs",
    "paxiom-receipt-mcp": "./mcp/server.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "canonicalization.md",
    "trust-states.md",
    "x402-delivery-receipt-extension.md",
    "paxiom.receipt.v0.schema.json",
    "openapi.json",
    "server.json",
    "src/",
    "bin/",
    "mcp/server.mjs",
    "server/server.mjs",
    "examples/"
  ],
  "scripts": {
    "validate": "node ./scripts/validate.mjs",
    "test": "node --test ./test/ ./server/ ./mcp/"
  },
  "keywords": [
    "x402",
    "receipts",
    "payment-receipt",
    "ed25519",
    "webcrypto",
    "cloudflare-workers",
    "agent-payments",
    "mcp",
    "proof-of-delivery",
    "verification",
    "paxiom",
    "buyer-firewall",
    "auth-capture-escrow"
  ]
}
