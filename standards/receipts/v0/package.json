{
  "name": "@paxiom/receipts",
  "version": "0.1.1",
  "description": "Zero-dependency issuer, verifier, HTTP middleware, and MCP server for paxiom.receipt.v0 — proof-bound cryptographic receipts for x402 and agentic APIs.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://paxiom.org/receipts.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-luecke/paxiom-static.git",
    "directory": "standards/receipts/v0"
  },
  "bugs": {
    "url": "https://github.com/k-luecke/paxiom-static/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./verify": "./src/verify.mjs",
    "./issue": "./src/issue.mjs",
    "./middleware": "./src/middleware.mjs",
    "./canonicalize": "./src/canonicalize.mjs",
    "./explain": "./src/explain.mjs",
    "./mcp": "./mcp/server.mjs",
    "./schema.json": "./paxiom.receipt.v0.schema.json"
  },
  "bin": {
    "paxiom-receipt": "./bin/paxiom-receipt.mjs",
    "paxiom-receipt-mcp": "./mcp/server.mjs"
  },
  "files": [
    "README.md",
    "canonicalization.md",
    "trust-states.md",
    "paxiom.receipt.v0.schema.json",
    "openapi.json",
    "src/",
    "bin/",
    "mcp/server.mjs",
    "server/server.mjs",
    "examples/"
  ],
  "scripts": {
    "validate": "node ./scripts/validate.mjs",
    "test": "node --test ./test/ ./server/ ./mcp/"
  },
  "keywords": [
    "x402",
    "receipts",
    "ed25519",
    "agent-payments",
    "mcp",
    "proof-of-delivery",
    "verification",
    "paxiom"
  ]
}
