{
  "openapi": "3.0.3",
  "info": {
    "title": "Paxiom Receipt Verifier",
    "version": "0.1.2",
    "x-status": "live",
    "description": "Verifier, counter-attestation, and x402 pre-payment readiness service for paxiom.receipt.v0 — proof-bound Ed25519 receipts for x402-paid and agentic APIs.\n\n- **Free offline verification (`POST /v1/receipt/verify`):** verifies receipt structure, Ed25519 signature over canonical JSON, SHA-256 output-hash binding, and honest settlement/evidence status with zero RPC calls (`settlement_claimed_not_checked` is never reported as `verified`).\n- **Live on-chain settlement verification (`POST /v1/receipt/verify-live`, $0.002 USDC via x402 or `X-API-Key`):** verifies canonical Base Mainnet (`eip155:8453`) and Base Sepolia (`eip155:84532`) USDC `Transfer` logs via multi-RPC failover and emits a Paxiom counter-attested receipt (`X-Paxiom-Receipt`).\n- **Pre-payment seller readiness scan (`POST /v1/x402/preflight`, $0.01 USDC via x402 or `X-API-Key`):** SSRF-hardened preflight scanner that probes an untrusted x402 endpoint before payment, verifying canonical Circle USDC asset address, EIP-712 domain parameters, `payTo` manifest consistency, and Paxiom receipt readiness.",
    "contact": {
      "name": "Paxiom",
      "url": "https://paxiom.org"
    }
  },
  "servers": [
    {
      "url": "https://api.paxiom.org",
      "description": "Public developer-preview verifier runtime (free offline verification on /v1/receipt/verify; inspect GET /version for opt-in live settlement capabilities)."
    },
    {
      "url": "http://localhost:8787",
      "description": "Local developer server (node runtime/receipt-verifier/server.mjs)."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "ok": true,
                  "service": "paxiom-receipt-verifier",
                  "version": "v0"
                }
              }
            }
          }
        }
      }
    },
    "/v1/receipt/demo": {
      "get": {
        "summary": "Canonical demo receipt + output",
        "description": "Returns a cryptographically real demo receipt and its delivered output, plus a hint for posting them to /v1/receipt/verify.",
        "operationId": "getDemo",
        "responses": {
          "200": {
            "description": "Demo fixtures",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Demo"
                }
              }
            }
          }
        }
      }
    },
    "/v1/receipt/verify": {
      "post": {
        "summary": "Verify a paxiom.receipt.v0 receipt (offline)",
        "operationId": "verifyReceipt",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              },
              "example": {
                "receipt": {
                  "receiptVersion": "paxiom.receipt.v0",
                  "payload": {},
                  "signature": {}
                },
                "output": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification ran. Body is the result — including non-verified outcomes (a receipt that failed a check is still a successful verification at the transport layer).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResult"
                },
                "examples": {
                  "verified": {
                    "summary": "verified",
                    "value": {
                      "valid": true,
                      "trustState": "verified",
                      "checks": {
                        "schema": "pass",
                        "signature": "pass",
                        "outputHash": "pass",
                        "requestBinding": "pass",
                        "paymentBinding": "pass",
                        "settlement": "verify_only",
                        "proof": "not_provided"
                      },
                      "receiptHash": "0xc6ceba580eda748250339f20d482c347d31c0b3260b3c813a3750814298f912e",
                      "summary": "Receipt verified: schema, Ed25519 signature, output binding, and settlement (verify_only) all consistent."
                    }
                  },
                  "output_hash_mismatch": {
                    "summary": "output_hash_mismatch",
                    "value": {
                      "valid": false,
                      "trustState": "output_hash_mismatch",
                      "checks": {
                        "schema": "pass",
                        "signature": "pass",
                        "outputHash": "fail",
                        "requestBinding": "pass",
                        "paymentBinding": "pass",
                        "settlement": "not_checked",
                        "proof": "not_checked"
                      },
                      "receiptHash": "0xc6ceba580eda748250339f20d482c347d31c0b3260b3c813a3750814298f912e",
                      "summary": "Supplied output hash 0x793f… != receipt delivery.outputHash 0x36b3…."
                    }
                  },
                  "settlement_claimed_not_checked": {
                    "summary": "settlement_claimed_not_checked",
                    "value": {
                      "valid": false,
                      "trustState": "settlement_claimed_not_checked",
                      "checks": {
                        "schema": "pass",
                        "signature": "pass",
                        "outputHash": "pass",
                        "requestBinding": "pass",
                        "paymentBinding": "pass",
                        "settlement": "claimed_not_checked",
                        "proof": "not_provided"
                      },
                      "receiptHash": "0x…",
                      "summary": "Signature and output hash verified. Receipt claims an onchain settlement that this offline verifier did not check."
                    }
                  },
                  "invalid_signature": {
                    "summary": "invalid_signature",
                    "value": {
                      "valid": false,
                      "trustState": "invalid_signature",
                      "checks": {
                        "schema": "pass",
                        "signature": "fail",
                        "outputHash": "not_checked",
                        "requestBinding": "not_checked",
                        "paymentBinding": "not_checked",
                        "settlement": "not_checked",
                        "proof": "not_checked"
                      },
                      "receiptHash": "0x…",
                      "summary": "Ed25519 signature does not verify over the canonical signing input."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed request (invalid JSON, or missing `receipt`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                },
                "example": {
                  "valid": false,
                  "trustState": "error",
                  "error": {
                    "code": "invalid_json",
                    "message": "Request body is not valid JSON"
                  }
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 256 KiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                },
                "example": {
                  "valid": false,
                  "trustState": "error",
                  "error": {
                    "code": "body_too_large",
                    "message": "Request body exceeds 256 KiB"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "summary": "Service identity, active capabilities, and explicit claim boundaries",
        "operationId": "getVersion",
        "responses": {
          "200": {
            "description": "Version and capability manifest",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/paxiom-keys.json": {
      "get": {
        "summary": "Published Paxiom counter-attestation Ed25519 public keys",
        "operationId": "getPaxiomKeys",
        "responses": {
          "200": {
            "description": "Active counter-attestation public key set",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/x402.json": {
      "get": {
        "summary": "x402 payment and Bazaar discovery manifest",
        "operationId": "getX402Discovery",
        "responses": {
          "200": {
            "description": "Discovery manifest reporting x402 gating configuration for /v1/receipt/verify-live",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "x402 payment gating is not enabled on this host."
          }
        }
      }
    },
    "/v1/receipt/verify-live": {
      "post": {
        "summary": "Verify receipt + live Base/Base-Sepolia USDC Transfer log settlement (opt-in)",
        "description": "Performs offline receipt verification and, when live settlement verification is enabled on the host, independently verifies the Base or Base Sepolia USDC Transfer log against JSON-RPC and optionally returns a Paxiom counter-attested receipt. Supports X-API-Key/Bearer or x402 payment gating when configured.",
        "operationId": "verifyReceiptLive",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "receipt"
                ],
                "properties": {
                  "receipt": {
                    "type": "object"
                  },
                  "output": {},
                  "expectedPayTo": {
                    "type": "string",
                    "description": "Optional expected 0x recipient address for the USDC Transfer log."
                  },
                  "counterAttest": {
                    "type": "boolean",
                    "description": "When true (default) and a Paxiom signing key is configured on the host, emits a counter-attested receipt on verified settlement."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification completed (includes liveSettlement details and optional counterAttestedReceipt).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResult"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON or missing receipt."
          },
          "402": {
            "description": "Payment required (x402 PaymentRequirements with outputSchema or invalid API key)."
          },
          "502": {
            "description": "Upstream RPC or facilitator error during live check."
          },
          "503": {
            "description": "Live settlement verification is not enabled on this host."
          }
        }
      }
    },
    "/v1/x402/preflight": {
      "post": {
        "summary": "SSRF-hardened pre-payment x402 seller readiness & canonical USDC check ($0.01 USDC / X-API-Key)",
        "description": "Probes an untrusted https:// x402 endpoint before an agent signs an EIP-3009 payment. Validates public DNS/IP ranges, inspects the 402 PaymentRequirements challenge and /.well-known/x402.json, verifies canonical Base / Base Sepolia USDC token address and EIP-712 domain, detects payTo bait-and-switch, checks Paxiom receipt support, and signs the report in X-Paxiom-Receipt.",
        "operationId": "x402Preflight",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "Target https:// x402 endpoint URL to inspect before paying."
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "POST",
                      "GET",
                      "HEAD"
                    ],
                    "default": "POST"
                  },
                  "maxBudgetAtomic": {
                    "type": "string",
                    "pattern": "^[0-9]+$",
                    "description": "Optional caller budget cap in USDC atomic units (6 decimals)."
                  },
                  "expectedNetwork": {
                    "type": "string",
                    "description": "Optional expected network (base, eip155:8453, base-sepolia, or eip155:84532)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preflight scan completed (verdict: proceed | caution | block).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or SSRF-blocked target URL (never charges x402 facilitator)."
          },
          "402": {
            "description": "Payment required ($0.01 USDC on Base via x402 or X-API-Key)."
          },
          "503": {
            "description": "Live x402 preflight scanning is not enabled on this host."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Demo": {
        "type": "object",
        "properties": {
          "receiptVersion": {
            "type": "string",
            "example": "paxiom.receipt.v0"
          },
          "output": {
            "type": "object",
            "description": "Delivered output bytes (JSON)."
          },
          "receipt": {
            "type": "object",
            "description": "A paxiom.receipt.v0 receipt."
          },
          "verify": {
            "type": "object",
            "description": "Hint: how to POST these back to the verifier."
          }
        }
      },
      "VerifyRequest": {
        "type": "object",
        "required": [
          "receipt"
        ],
        "properties": {
          "receipt": {
            "type": "object",
            "description": "A paxiom.receipt.v0 receipt. See standards/receipts/v0/paxiom.receipt.v0.schema.json."
          },
          "output": {
            "description": "Optional delivered output. When present, enables the payment-to-output binding check. Omit to check signature only."
          }
        }
      },
      "VerifyResult": {
        "type": "object",
        "required": [
          "valid",
          "trustState",
          "checks"
        ],
        "properties": {
          "valid": {
            "type": "boolean",
            "description": "true only when trustState === \"verified\"."
          },
          "trustState": {
            "type": "string",
            "description": "One deterministic verdict. See standards/receipts/v0/trust-states.md.",
            "enum": [
              "verified",
              "valid_signature_only",
              "schema_invalid",
              "unsupported_format",
              "invalid_signature",
              "request_binding_missing",
              "payment_binding_missing",
              "output_hash_mismatch",
              "settlement_claimed_not_checked",
              "settlement_failed",
              "proof_not_provided",
              "proof_unavailable",
              "proof_invalid",
              "expired",
              "error"
            ]
          },
          "checks": {
            "type": "object",
            "description": "Per-dimension breakdown (schema, signature, outputHash, requestBinding, paymentBinding, settlement, proof)."
          },
          "receiptHash": {
            "type": [
              "string",
              "null"
            ],
            "description": "Non-authoritative display hash derived by the verifier; not part of the signed payload."
          },
          "summary": {
            "type": "string"
          }
        }
      },
      "ErrorResult": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean",
            "example": false
          },
          "trustState": {
            "type": "string",
            "example": "error"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
