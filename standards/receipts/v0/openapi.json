{
  "openapi": "3.0.3",
  "info": {
    "title": "Paxiom Receipt Verifier",
    "version": "0.4.0",
    "x-status": "live",
    "description": "Free public reference verifier, counter-attestation utility, and x402 pre-payment readiness scanner for paxiom.receipt.v0 \u2014 open MIT proof-bound Ed25519 delivery receipts for x402-paid and agentic APIs.\n\n- **Free offline verification (`POST /v1/receipt/verify`):** verifies receipt structure, Ed25519 signature over canonical JSON, signer authorization (`expectedIssuerPublicKeys` / `expectedPayTo`), `jcs-sha256` or `raw-sha256` output-hash binding, and honest settlement/evidence status with zero RPC calls (`settlement_claimed_not_checked` is never reported as `verified`).\n- **Free rate-limited live on-chain settlement verification (`POST /v1/receipt/verify-live`):** verifies canonical Base Mainnet (`eip155:8453`) and Base Sepolia (`eip155:84532`) USDC `Transfer` logs via multi-RPC failover and emits an Ed25519 counter-attested receipt (`Payment-Receipt` and `X-Paxiom-Receipt`).\n- **Free rate-limited pre-payment seller readiness scan (`POST /v1/x402/preflight`):** SSRF-hardened preflight scanner that probes an untrusted x402 endpoint before payment, verifying canonical Circle USDC asset address, EIP-712 domain parameters, `payTo` manifest consistency, and `Payment-Receipt` / `X-Paxiom-Receipt` readiness.",
    "contact": {
      "name": "Paxiom",
      "url": "https://paxiom.org"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://api.paxiom.org",
      "description": "Free public rate-limited reference verifier runtime (inspect GET /version for active capabilities and rate limits)."
    },
    {
      "url": "http://localhost:8787",
      "description": "Local developer server (node runtime/receipt-verifier/server.mjs)."
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Machine-readable service discovery index",
        "operationId": "getRootServiceIndex",
        "responses": {
          "200": {
            "description": "Service identity, SDK links, discovery manifests, and active endpoints.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "OpenAPI 3.0 specification for Paxiom Receipt Verifier",
        "operationId": "getOpenApiSpec",
        "responses": {
          "200": {
            "description": "OpenAPI specification JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/llms.txt": {
      "get": {
        "summary": "LLM & autonomous agent capability and claim-boundary summary",
        "operationId": "getLlmsTxt",
        "responses": {
          "200": {
            "description": "Plain-text llms.txt document.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/mcp.json": {
      "get": {
        "summary": "Model Context Protocol (MCP) Streamable-HTTP discovery card",
        "operationId": "getMcpServerCard",
        "responses": {
          "200": {
            "description": "MCP Server Card advertising POST /mcp and available tools.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "summary": "Zero-PII aggregate telemetry counters",
        "operationId": "getFunnelStats",
        "responses": {
          "200": {
            "description": "Aggregate request and verification counters since process boot (zero PII).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Liveness check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "ok": true,
                  "service": "paxiom-receipt-verifier",
                  "version": "0.4.0"
                }
              }
            }
          }
        }
      }
    },
    "/v1/receipt/demo": {
      "get": {
        "summary": "Canonical demo receipt + output",
        "description": "Returns a cryptographically real demo receipt and its delivered output, plus a hint for posting them to /v1/receipt/verify.",
        "operationId": "getDemo",
        "responses": {
          "200": {
            "description": "Demo fixtures",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Demo"
                }
              }
            }
          }
        }
      }
    },
    "/v1/receipt/verify": {
      "post": {
        "summary": "Verify a paxiom.receipt.v0 receipt (offline)",
        "operationId": "verifyReceipt",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              },
              "example": {
                "receipt": {
                  "receiptVersion": "paxiom.receipt.v0",
                  "payload": {},
                  "signature": {}
                },
                "output": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification ran. Body is the result \u2014 including non-verified outcomes (a receipt that failed a check is still a successful verification at the transport layer).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResult"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request (invalid JSON, or missing `receipt`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 256 KiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "summary": "Service identity, active capabilities, rate limits, and explicit claim boundaries",
        "operationId": "getVersion",
        "responses": {
          "200": {
            "description": "Version and capability manifest",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/x402-keys.json": {
      "get": {
        "summary": "Published Ed25519 public keys for receipt & counter-attestation verification",
        "operationId": "getX402Keys",
        "responses": {
          "200": {
            "description": "Active Ed25519 public key set",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/paxiom-keys.json": {
      "get": {
        "summary": "Legacy alias for /.well-known/x402-keys.json",
        "operationId": "getPaxiomKeys",
        "responses": {
          "200": {
            "description": "Active counter-attestation public key set",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/receipt/verify-live": {
      "post": {
        "summary": "Verify receipt + live Base/Base-Sepolia USDC Transfer log settlement (free, rate-limited)",
        "description": "Performs offline receipt verification and independently verifies the Base or Base Sepolia USDC Transfer log against JSON-RPC, optionally returning an Ed25519 counter-attested receipt (`Payment-Receipt` and `X-Paxiom-Receipt`). Free public reference endpoint protected by per-IP burst rate limiting.",
        "operationId": "verifyReceiptLive",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "receipt"
                ],
                "properties": {
                  "receipt": {
                    "type": "object"
                  },
                  "output": {},
                  "expectedPayTo": {
                    "type": "string",
                    "description": "Expected 0x recipient address for the USDC Transfer log (required to mint a counter-attested receipt)."
                  },
                  "expectedIssuerPublicKeys": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Optional pinned seller Ed25519 public keys."
                  },
                  "counterAttest": {
                    "type": "boolean",
                    "description": "When true (default) and a signing key is configured on the host, emits a counter-attested receipt on verified settlement."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification completed (includes onchainSettlement details and optional counterAttestedReceipt).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResult"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON or missing receipt."
          },
          "429": {
            "description": "Per-IP rate limit exceeded (see Retry-After header)."
          },
          "502": {
            "description": "Upstream RPC error during live check."
          },
          "503": {
            "description": "Live settlement verification is not enabled on this host."
          }
        }
      }
    },
    "/v1/x402/preflight": {
      "post": {
        "summary": "SSRF-hardened pre-payment x402 seller readiness & canonical USDC check (free, rate-limited)",
        "description": "Probes an untrusted https:// x402 endpoint before an agent signs an EIP-3009 payment. Validates public DNS/IP ranges, inspects the 402 PaymentRequirements challenge and /.well-known/x402.json, verifies canonical Base / Base Sepolia USDC token address and EIP-712 domain, detects payTo bait-and-switch, checks Payment-Receipt / X-Paxiom-Receipt and /.well-known/x402-keys.json support, and signs the report.",
        "operationId": "x402Preflight",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "Target https:// x402 endpoint URL to inspect before paying."
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "POST",
                      "GET",
                      "HEAD"
                    ],
                    "default": "POST"
                  },
                  "maxBudgetAtomic": {
                    "type": "string",
                    "pattern": "^[0-9]+$",
                    "description": "Optional caller budget cap in USDC atomic units (6 decimals)."
                  },
                  "expectedNetwork": {
                    "type": "string",
                    "description": "Optional expected network (base, eip155:8453, base-sepolia, or eip155:84532)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preflight scan completed (verdict: proceed | caution | block).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or SSRF-blocked target URL."
          },
          "403": {
            "description": "Cross-site browser request rejected."
          },
          "429": {
            "description": "Per-IP rate limit exceeded (see Retry-After header)."
          },
          "503": {
            "description": "Live x402 preflight scanning is not enabled on this host."
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "summary": "Stateless MCP Streamable-HTTP JSON-RPC 2.0 endpoint",
        "description": "Zero-install remote Model Context Protocol (MCP) Streamable-HTTP server (`io.github.k-luecke/paxiom-receipts`, protocol `2025-03-26`) exposing `verify_receipt`, `explain_receipt`, and `get_x402_verifier_info`.",
        "operationId": "postMcpJsonRpc",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC 2.0 response payload."
          },
          "202": {
            "description": "JSON-RPC 2.0 notification acknowledged."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Demo": {
        "type": "object",
        "properties": {
          "receiptVersion": {
            "type": "string",
            "example": "paxiom.receipt.v0"
          },
          "output": {
            "type": "object",
            "description": "Delivered output bytes (JSON)."
          },
          "receipt": {
            "type": "object",
            "description": "A paxiom.receipt.v0 receipt."
          },
          "verify": {
            "type": "object",
            "description": "Hint: how to POST these back to the verifier."
          }
        }
      },
      "VerifyRequest": {
        "type": "object",
        "required": [
          "receipt"
        ],
        "properties": {
          "receipt": {
            "type": "object",
            "description": "A paxiom.receipt.v0 receipt. See standards/receipts/v0/paxiom.receipt.v0.schema.json."
          },
          "output": {
            "description": "Optional delivered output (JSON value for jcs-sha256, or UTF-8 string for raw-sha256). Omit to check signature only."
          },
          "expectedIssuerPublicKeys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional pinned seller Ed25519 public keys (e.g. discovered from /.well-known/x402-keys.json)."
          },
          "expectedPayTo": {
            "type": "string",
            "description": "Optional expected seller payTo address from the 402 quote."
          },
          "trustedVerifierPublicKeys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional Ed25519 public keys trusted to assert settlement.checkedByVerifier=true."
          }
        }
      },
      "VerifyResult": {
        "type": "object",
        "required": [
          "valid",
          "trustState",
          "checks"
        ],
        "properties": {
          "valid": {
            "type": "boolean",
            "description": "true only when trustState === \"verified\"."
          },
          "trustState": {
            "type": "string",
            "description": "One deterministic verdict. See standards/receipts/v0/trust-states.md.",
            "enum": [
              "verified",
              "valid_signature_only",
              "schema_invalid",
              "unsupported_format",
              "invalid_signature",
              "unauthorized_issuer",
              "request_binding_missing",
              "payment_binding_missing",
              "output_hash_mismatch",
              "settlement_claimed_not_checked",
              "settlement_failed",
              "proof_not_provided",
              "proof_unavailable",
              "proof_invalid",
              "expired",
              "error"
            ]
          },
          "checks": {
            "type": "object",
            "description": "Per-dimension breakdown (schema, signature, issuerAuthorization, outputHash, requestBinding, paymentBinding, settlement, proof)."
          },
          "receiptHash": {
            "type": [
              "string",
              "null"
            ],
            "description": "Non-authoritative display hash derived by the verifier; not part of the signed payload."
          },
          "summary": {
            "type": "string"
          }
        }
      },
      "ErrorResult": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean",
            "example": false
          },
          "trustState": {
            "type": "string",
            "example": "error"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
